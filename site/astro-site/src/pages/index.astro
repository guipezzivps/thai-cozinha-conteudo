---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);

const faqs = [
  {
    q: 'Os lanches da Thai Cozinha são realmente sem glúten e sem lactose?',
    a: 'Sim. A linha Fit e Funcional da Thai Cozinha tem opções sem glúten, sem lactose e sem proteína do leite de vaca (APLV), com identificação clara de cada restrição em todos os produtos do cardápio.',
  },
  {
    q: 'A Thai Cozinha entrega em toda Porto Alegre?',
    a: 'Sim, a Thai Cozinha atende toda a região de Porto Alegre, RS, com pedidos feitos pelo WhatsApp ou pela loja online.',
  },
  {
    q: 'Os produtos têm informação nutricional?',
    a: 'Sim. Cada produto do cardápio tem informação nutricional completa por porção (calorias, proteínas, carboidratos, gorduras e fibras), ideal para quem acompanha macros ou está em processo de emagrecimento.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'LocalBusiness',
      name: 'Thai – Cozinha Fit Inclusiva',
      description:
        'Salgados e doces artesanais fit, sem glúten, sem lactose e sem proteína do leite de vaca (APLV), com entrega em Porto Alegre, RS.',
      url: 'https://thaicozinha.com.br',
      areaServed: 'Porto Alegre, RS',
      sameAs: ['https://www.instagram.com/thaicozinha_fit'],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<Layout
  title="Conteúdo sobre alimentação fit, sem glúten e sem lactose"
  description="Artigos sobre alimentação fit, sem glúten, sem lactose e inclusiva, direto da Thai – Cozinha Fit Inclusiva, de Porto Alegre."
  jsonLd={jsonLd}
>
  <section>
    <p style="text-transform:uppercase;letter-spacing:0.12em;font-size:0.75rem;color:var(--ink-soft);font-weight:700;">
      Thai – Cozinha Fit Inclusiva
    </p>
    <h1 style="font-size:2rem;line-height:1.15;margin:0.4rem 0 1rem;">
      Comida fit que não parece comida fit
    </h1>
    <p>
      Este é o espaço de conteúdo da Thai Cozinha: dicas, receitas e informação sobre alimentação
      sem glúten, sem lactose e sem proteína do leite (APLV) — pensado pra quem tem restrição
      alimentar e não quer abrir mão do sabor.
    </p>
    <p>
      Quer ver o cardápio completo e fazer um pedido? Acesse
      <a href="https://thaicozinha.com.br">thaicozinha.com.br</a>.
    </p>
  </section>

  {posts.length > 0 && (
    <section style="margin-top:2.5rem;">
      <h2 style="font-size:1.15rem;">Últimos artigos</h2>
      <ul style="list-style:none;padding:0;margin:0;">
        {posts.map((post) => (
          <li style="margin-bottom:1.25rem;">
            <a href={`/blog/${post.id}/`} style="font-weight:600;text-decoration:none;color:var(--ink);">
              {post.data.title}
            </a>
            <p style="margin:0.25rem 0 0;color:var(--ink-soft);">{post.data.description}</p>
          </li>
        ))}
      </ul>
      <a href="/blog">Ver todos os artigos →</a>
    </section>
  )}

  <section style="margin-top:2.5rem;">
    <h2 style="font-size:1.15rem;">Perguntas frequentes</h2>
    {faqs.map((f) => (
      <div style="margin-bottom:1.25rem;">
        <p style="font-weight:600;margin:0 0 0.25rem;">{f.q}</p>
        <p style="margin:0;color:var(--ink-soft);">{f.a}</p>
      </div>
    ))}
  </section>
</Layout>
