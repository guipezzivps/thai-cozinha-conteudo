---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);
---

<Layout
  title="Blog"
  description="Artigos sobre alimentação fit, sem glúten, sem lactose e inclusiva da Thai Cozinha."
>
  <h1 style="font-size:1.75rem;">Blog</h1>
  {posts.length === 0 && <p>Ainda não tem artigo publicado por aqui.</p>}
  <ul style="list-style:none;padding:0;margin:0;">
    {posts.map((post) => (
      <li style="margin-bottom:1.5rem;">
        <a href={`/blog/${post.id}/`} style="font-weight:600;text-decoration:none;color:var(--ink);font-size:1.05rem;">
          {post.data.title}
        </a>
        <p style="margin:0.25rem 0 0;color:var(--ink-soft);">{post.data.description}</p>
        <time datetime={post.data.publishedAt.toISOString()} style="font-size:0.85rem;color:var(--ink-soft);">
          {post.data.publishedAt.toLocaleDateString('pt-BR', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
        </time>
      </li>
    ))}
  </ul>
</Layout>
